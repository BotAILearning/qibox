{
  "name": "qibox",
  "version": "0.9.17",
  "private": true,
  "type": "module",
  "description": "栖盒：在 NAS 上安装和运行 Linux 应用",
  "scripts": {
    "dev": "node server/index.mjs --dev",
    "dev:shadow": "node scripts/dev-shadow.mjs",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "build:web": "node scripts/build.mjs --ui-only",
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "test:desktop": "node scripts/test-desktop.mjs",
    "test:ai-ui": "node scripts/test-ai-ui.mjs",
    "test:ugos-ui": "node scripts/test-ugos-ui.mjs --missing-role --transient-session --unauthorized-session --transient-token --cross-origin"
  },
  "dependencies": {
    "@novnc/novnc": "1.7.0",
    "@trimjs/web-app": "0.4.2",
    "@ugreen-nas/core": "1.7.41",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "sharp": "0.35.4"
  }
}
